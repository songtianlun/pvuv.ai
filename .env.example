# Copy to .env. Never commit real values. Use the SAME existing HMAC_KEY for D1 cutover.
HMAC_KEY=
PUBLIC_URL=https://analytics.example.com
ADMIN_EMAILS=you@example.com
INGEST_HOST=in.example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
API_TOKEN=
# Shared secret with your reverse proxy for authenticated client metadata.
PROXY_TOKEN=
# Standalone only: comma-separated IPs/CIDRs of trusted Traefik/proxy hops.
# Set this to your actual proxy source ranges; empty ignores X-Forwarded-For.
TRUSTED_PROXY_CIDRS=
DEFAULT_LANG=en
# For development outside Docker:
# SQLITE_PATH=data/pvuv.sqlite
# For published images:
# PVUV_IMAGE=your-dockerhub-user/pvuv.ai:devel
